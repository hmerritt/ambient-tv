{
    "name": "ambient-tv",
    "version": "1.8.18",
    "main": "index.js",
    "scripts": {
        "start": "expo start --tunnel",
        "android": "expo start --android --tunnel",
        "android:build": "expo export --platform android && yarn dlx eas-cli@latest build --platform android --profile production --local",
        "android:build:development": "expo export --platform android && yarn dlx eas-cli@latest build --platform android --profile development --local --clear-cache",
        "android:build:remote": "yarn dlx eas-cli@latest build --platform android --profile production",
        "android:build:development:remote": "yarn dlx eas-cli@latest build --platform android --profile development",
        "ios": "expo start --ios",
        "ios:build:remote": "yarn dlx eas-cli@latest build --platform ios --profile production",
        "ios:build:development:remote": "yarn dlx eas-cli@latest build --platform ios --profile development",
        "web": "expo start --web",
        "web:build": "expo export --platform web",
        "typecheck": "tsc --noEmit",
        "format:check": "prettier --check \"app/**/*.{ts,tsx,js,jsx}\" \"src/**/*.{ts,tsx,js,jsx}\" \"plugins/**/*.{ts,tsx,js,jsx}\" \"*.{json,js,ts}\"",
        "doctor": "expo-doctor",
        "update": "yarn upgrade-interactive"
    },
    "dependencies": {
        "@expo/metro-runtime": "~57.0.10",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@reduxjs/toolkit": "2.12.0",
        "axios": "1.19.0",
        "chance": "1.1.13",
        "expo": "~57.0.13",
        "expo-build-properties": "~57.0.11",
        "expo-constants": "~57.0.11",
        "expo-font": "~57.0.1",
        "expo-keep-awake": "~57.0.1",
        "expo-linear-gradient": "~57.0.1",
        "expo-linking": "~57.0.6",
        "expo-location": "~57.0.10",
        "expo-navigation-bar": "~57.0.2",
        "expo-router": "~57.0.13",
        "expo-splash-screen": "~57.0.6",
        "expo-status-bar": "~57.0.1",
        "expo-video": "~57.0.2",
        "moment": "2.30.1",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "npm:react-native-tvos@0.86-stable",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-reanimated": "4.5.1",
        "react-native-rss-parser": "1.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-web": "~0.21.0",
        "react-native-worklets": "0.10.1",
        "react-redux": "9.3.0",
        "redux": "5.0.1",
        "redux-logger": "3.0.6"
    },
    "devDependencies": {
        "@babel/core": "7.29.7",
        "@expo/ngrok": "4.1.3",
        "@react-native/metro-config": "0.86.2",
        "@trivago/prettier-plugin-sort-imports": "6.0.2",
        "@types/node": "26.2.0",
        "@types/react": "~19.2.2",
        "expo-doctor": "1.20.2",
        "prettier": "3.9.6",
        "typescript": "~6.0.3"
    },
    "expo": {
        "install": {
            "exclude": [
                "react-native"
            ]
        }
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "private": true,
    "packageManager": "yarn@4.18.0"
}
