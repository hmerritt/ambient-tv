{
    "expo": {
        "version": "1.8.18",
        "name": "Ambient TV",
        "slug": "ambient-tv",
        "scheme": "ambient-tv",
        "orientation": "landscape",
        "icon": "./assets/icon.png",
        "ios": {
            "icon": "./assets/icon-no-alpha.png",
            "bundleIdentifier": "com.hmerritt.ambient.tv",
            "buildNumber": "1.8.18",
            "deploymentTarget": "16.4",
            "supportsTablet": true,
            "requireFullScreen": true,
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false
            }
        },
        "android": {
            "versionCode": 38,
            "package": "com.hmerritt.ambient.tv",
            "permissions": [
                "ACCESS_FINE_LOCATION",
                "android.permission.MODIFY_AUDIO_SETTINGS"
            ],
            "intentFilters": [
                {
                    "action": "MAIN",
                    "category": ["LAUNCHER", "LEANBACK_LAUNCHER"],
                    "autoVerify": false,
                    "data": {}
                },
                {
                    "action": "VIEW",
                    "category": ["DEFAULT", "BROWSABLE"],
                    "autoVerify": false,
                    "data": {}
                }
            ],
            "icon": "./assets/icon.png",
            "playStoreUrl": "https://play.google.com/store/apps/details?id=com.hmerritt.ambient.tv"
        },
        "web": {
            "name": "Ambient TV",
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/favicon.png"
        },
        "plugins": [
            "./plugins/withDrawableAssets.ts",
            "./plugins/withAndroidManifestInject.ts",
            "./plugins/withAndroidDreamService.ts",
            "expo-router",
            [
                "expo-build-properties",
                {
                    "android": {
                        "compileSdkVersion": 36,
                        "targetSdkVersion": 36,
                        "useLegacyPackaging": true,
                        "enableShrinkResourcesInReleaseBuilds": true,
                        "enableMinifyInReleaseBuilds": true
                    }
                }
            ],
            [
                "expo-navigation-bar",
                {
                    "enforceContrast": false,
                    "hidden": true,
                    "style": "dark"
                }
            ],
            ["expo-status-bar", { "hidden": true, "style": "light" }],
            [
                "expo-splash-screen",
                {
                    "image": "./assets/splash.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#ffffff"
                }
            ]
        ],
        "updates": {
            "enabled": false,
            "fallbackToCacheTimeout": 0
        },
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": false
        },
        "extra": {
            "eas": {
                "projectId": "23508b3c-d3c7-46c6-9cfb-b7572bc61d50"
            }
        }
    }
}
