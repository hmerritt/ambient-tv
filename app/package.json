{
    "name": "ambient-tv",
    "version": "1.6.18",
    "main": "expo-router/entry",
    "scripts": {
        "start": "expo start --tunnel",
        "android": "expo start --android --tunnel",
        "android:build": "expo export --platform android && eas build --platform android --profile production --local",
        "android:build:development": "expo export --platform android && eas build --platform android --profile development --local --clear-cache",
        "android:build:remote": "eas build --platform android --profile production",
        "android:build:development:remote": "eas build --platform android --profile development",
        "ios": "expo start --ios",
        "ios:build:remote": "eas build --platform ios --profile production",
        "ios:build:development:remote": "eas build --platform ios --profile development",
        "web": "expo start --web",
        "web:build": "expo export --platform web",
        "update": "yarn upgrade-interactive"
    },
    "dependencies": {
        "@expo/metro-runtime": "6.1.2",
        "@expo/vector-icons": "15.0.2",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@react-native-masked-view/masked-view": "0.3.2",
        "@react-navigation/native": "7.1.17",
        "@reduxjs/toolkit": "2.9.0",
        "axios": "1.12.2",
        "chance": "1.1.13",
        "expo": "54.0.9",
        "expo-av": "16.0.7",
        "expo-build-properties": "1.0.9",
        "expo-constants": "18.0.9",
        "expo-dev-client": "6.0.12",
        "expo-font": "14.0.8",
        "expo-keep-awake": "15.0.7",
        "expo-linear-gradient": "15.0.7",
        "expo-linking": "8.0.8",
        "expo-location": "19.0.7",
        "expo-navigation-bar": "5.0.8",
        "expo-router": "6.0.7",
        "expo-splash-screen": "31.0.10",
        "expo-status-bar": "3.0.8",
        "moment": "2.30.1",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-native": "npm:react-native-tvos@latest",
        "react-native-gesture-handler": "2.28.0",
        "react-native-reanimated": "4.1.0",
        "react-native-rss-parser": "1.5.1",
        "react-native-safe-area-context": "5.6.1",
        "react-native-screens": "4.16.0",
        "react-native-tvos": "^0.81.4-0",
        "react-native-web": "0.21.1",
        "react-native-webview": "13.16.0",
        "react-redux": "9.2.0",
        "redux": "5.0.1",
        "redux-logger": "3.0.6"
    },
    "devDependencies": {
        "@babel/core": "7.28.4",
        "@babel/plugin-transform-private-methods": "7.27.1",
        "@babel/plugin-transform-private-property-in-object": "7.27.1",
        "@trivago/prettier-plugin-sort-imports": "5.2.2",
        "@types/react": "19.1.13",
        "expo-module-scripts": "5.0.7",
        "prettier": "3.6.2",
        "react-native-worklets": "0.5.1",
        "react-native-worklets-core": "1.6.2",
        "typescript": "5.9.2"
    },
    "expo": {
        "install": {
            "exclude": [
                "react-native"
            ]
        }
    },
    "private": true,
    "packageManager": "yarn@4.10.2"
}
